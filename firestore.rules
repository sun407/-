rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidResume(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.title is string &&
             data.title.size() <= 200 &&
             (!('photoUploadedAt' in data) || data.photoUploadedAt == null || (data.photoUploadedAt is string && data.photoUploadedAt.size() <= 64));
    }

    // Connection validation endpoint
    match /test/connection {
      allow read: if true;
    }

    match /resumes/{resumeId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                       isValidId(resumeId) &&
                       incoming().userId == request.auth.uid &&
                       isValidResume(incoming());
      allow update: if isSignedIn() &&
                       isValidId(resumeId) &&
                       existing().userId == request.auth.uid &&
                       incoming().userId == request.auth.uid &&
                       isValidResume(incoming());
      allow delete: if isSignedIn() &&
                       isValidId(resumeId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
